# 本地开发环境变量参考；默认配置不需要额外设置。
HOST=0.0.0.0
PORT=3000
PUBLIC_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_PATH=./apps/server/storage/gamehall.sqlite

# Render 会自动提供 RENDER_EXTERNAL_HOSTNAME，因此 PUBLIC_ORIGIN 可留空。
# 使用自定义域名时，将 PUBLIC_ORIGIN 与 ALLOWED_ORIGINS 改为对应的 https 地址。
