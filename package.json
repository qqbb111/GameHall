{
  "name": "gamehall",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gamehall/web --filter @gamehall/server dev",
    "dev:web": "pnpm --filter @gamehall/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @gamehall/server test:integration",
    "smoke:load": "pnpm --filter @gamehall/server smoke:load",
    "migrate": "pnpm --filter @gamehall/server migrate"
  }
}
